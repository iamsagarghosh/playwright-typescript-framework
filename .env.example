# Supported environments: local, qa, staging, uat.
TEST_ENV=local

# Optional for local. QA, staging, and UAT require an explicit authorized test URL.
BASE_URL=

# Exact hostname allowlist for BASE_URL overrides. Comma-separated; no wildcards.
# Local defaults already allow demoapps.leapwork.ai and loopback hosts.
ALLOWED_BASE_URL_HOSTS=

# Optional demo application credentials. Keep actual secrets in an untracked .env file.
TEST_USERNAME=
TEST_PASSWORD=
