{
  "name": "playwright-typescript-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Application-independent Playwright and TypeScript UI automation framework",
  "scripts": {
    "browsers:install": "node scripts/playwright-cli.cjs install chromium",
    "test": "node scripts/playwright-cli.cjs test",
    "test:smoke": "node scripts/playwright-cli.cjs test --grep @smoke",
    "test:sanity": "node scripts/playwright-cli.cjs test --grep @sanity",
    "test:regression": "node scripts/playwright-cli.cjs test --grep @regression",
    "test:e2e": "node scripts/playwright-cli.cjs test --grep @e2e",
    "test:chromium": "node scripts/playwright-cli.cjs test --project=chromium",
    "test:edge": "node scripts/playwright-cli.cjs test --project=edge",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
